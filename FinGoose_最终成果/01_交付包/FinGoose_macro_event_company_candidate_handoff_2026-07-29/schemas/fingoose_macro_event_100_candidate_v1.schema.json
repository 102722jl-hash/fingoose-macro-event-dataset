{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fingoose.local/schemas/fingoose_macro_event_100_candidate_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "dataset_version",
    "event_id",
    "sample_kind",
    "target_series_ids",
    "forecast_as_of_at",
    "visible_evidence_ids",
    "period_comparison",
    "fact_transmission_chain",
    "supporting_observations",
    "counterevidence",
    "alternative_explanation",
    "short_horizon_prediction",
    "semantic_fingerprint",
    "review_status",
    "final_commentary"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^macro-event-100-v1-event-[0-9]{2}-[0-9]{2}$"},
    "dataset_version": {"const": "fingoose-macro-event-100-candidate-v1.0"},
    "event_id": {"type": "string", "pattern": "^event-[0-9]{2}$"},
    "sample_kind": {"enum": ["single_target", "cross_asset", "channel_check", "counterfactual"]},
    "target_series_ids": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forecast_as_of_at": {"type": "string", "format": "date-time"},
    "visible_evidence_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "period_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date", "summary"],
      "properties": {
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "fact_transmission_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "selected_channel"],
      "properties": {
        "nodes": {"type": "array", "minItems": 3, "items": {"type": "object"}},
        "edges": {"type": "array", "minItems": 2, "items": {"type": "object"}},
        "selected_channel": {"type": "string", "minLength": 1}
      }
    },
    "supporting_observations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["series_id", "series_name", "expected_direction", "d1_change", "d3_change", "period_end_date"],
        "properties": {
          "series_id": {"type": "string", "minLength": 1},
          "series_name": {"type": "string", "minLength": 1},
          "expected_direction": {"enum": ["UP", "DOWN", "FLAT", "UNCERTAIN"]},
          "d1_change": {"type": "number"},
          "d3_change": {"type": "number"},
          "period_end_date": {"type": "string", "format": "date"}
        }
      }
    },
    "counterevidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "alternative_explanation": {"type": "string", "minLength": 1},
    "short_horizon_prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_series_id", "direction", "confidence", "invalidation_conditions", "horizon"],
      "properties": {
        "target_series_id": {"type": "string", "minLength": 1},
        "direction": {"enum": ["UP", "DOWN", "FLAT", "UNCERTAIN"]},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "horizon": {"const": "SHORT_HORIZON"}
      }
    },
    "semantic_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review_status": {"const": "PENDING_HUMAN_REVIEW"},
    "final_commentary": {"type": "string", "minLength": 150, "maxLength": 300}
  }
}
