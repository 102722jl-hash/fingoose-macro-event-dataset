{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fingoose.local/schemas/fingoose_macro_event_dossier_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "dataset_version", "title", "category", "anchor_at", "occurred_at", "first_public_at", "phase", "candidate_channels", "source_ids", "target_series_ids"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^event-[0-9]{2}$"},
    "dataset_version": {"const": "fingoose-macro-event-attribution-v1.0"},
    "title": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "anchor_at": {"type": "string", "format": "date-time"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "first_public_at": {"type": "string", "format": "date-time"},
    "phase": {"type": "string", "minLength": 1},
    "candidate_channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "target_series_ids": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
