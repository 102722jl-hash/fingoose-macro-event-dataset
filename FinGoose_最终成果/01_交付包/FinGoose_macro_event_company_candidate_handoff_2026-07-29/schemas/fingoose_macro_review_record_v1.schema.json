{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fingoose.local/schemas/fingoose_macro_review_record_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "dataset_version", "event_id", "initial_review", "second_review", "adjudication", "second_review_trigger_reasons", "final_label", "confidence", "core_dimensions"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "dataset_version": {"const": "fingoose-macro-event-attribution-v1.0"},
    "event_id": {"type": "string", "pattern": "^event-[0-9]{2}$"},
    "initial_review": {"$ref": "#/$defs/review"},
    "second_review": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/review"}]},
    "adjudication": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/review"}]},
    "second_review_trigger_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "LOW_CONFIDENCE", "STRONG_COMPETING_EXPLANATION",
          "CORE_DIMENSION_UNKNOWN", "CORE_DIMENSION_CONTRADICTED"
        ]
      }
    },
    "final_label": {"enum": ["PRIMARY_DRIVER", "CONTRIBUTING_FACTOR", "WEAK_RELATION", "UNSUPPORTED"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "core_dimensions": {
      "type": "object", "additionalProperties": false,
      "required": ["temporal_alignment", "abnormal_movement", "transmission_mechanism", "competing_explanations"],
      "properties": {
        "temporal_alignment": {"enum": ["SUPPORTED", "CONTRADICTED", "UNKNOWN"]},
        "abnormal_movement": {"enum": ["SUPPORTED", "CONTRADICTED", "UNKNOWN"]},
        "transmission_mechanism": {"enum": ["SUPPORTED", "CONTRADICTED", "UNKNOWN"]},
        "competing_explanations": {"enum": ["LIMITED", "MIXED", "STRONG", "UNKNOWN"]}
      }
    }
  },
  "$defs": {
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_id", "status"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["APPROVED", "PENDING"]},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "comments": {"type": "string", "minLength": 1},
        "label": {"enum": ["PRIMARY_DRIVER", "CONTRIBUTING_FACTOR", "WEAK_RELATION", "UNSUPPORTED"]},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "core_dimensions": {"$ref": "#/properties/core_dimensions"}
      },
      "allOf": [{
        "if": {
          "properties": {"status": {"const": "APPROVED"}},
          "required": ["status"]
        },
        "then": {
          "required": ["reviewed_at", "comments", "label", "confidence", "core_dimensions"]
        }
      }]
    }
  }
}
