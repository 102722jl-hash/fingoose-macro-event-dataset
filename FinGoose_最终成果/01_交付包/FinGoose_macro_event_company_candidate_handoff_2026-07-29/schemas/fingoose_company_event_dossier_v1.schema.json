{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fingoose.local/schemas/fingoose_company_event_dossier_v1.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["dossier_id", "dataset_version", "event_id", "company_code", "company_name", "source_tier", "observation_quarter", "association", "direction", "transmission_chain"],
  "properties": {
    "dossier_id": {"type": "string", "pattern": "^company-dossier-event-[0-9]{2}-[0-9]{6}-(sh|sz)$"},
    "dataset_version": {"const": "fingoose-macro-event-company-v1.0"},
    "event_id": {"type": "string", "pattern": "^event-[0-9]{2}$"},
    "company_code": {"$ref": "#/$defs/companyCode"},
    "company_name": {"type": "string", "minLength": 1},
    "source_tier": {"$ref": "#/$defs/sourceTier"},
    "observation_quarter": {"$ref": "#/$defs/quarter"},
    "association": {"$ref": "#/$defs/association"},
    "direction": {"$ref": "#/$defs/direction"},
    "confidence": {"$ref": "#/$defs/confidence"},
    "transmission_chain": {"$ref": "#/$defs/transmissionChain"}
  },
  "$defs": {
    "companyCode": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ)$"},
    "sourceTier": {"enum": ["TIER_1", "TIER_2", "TIER_3"]},
    "quarter": {"type": "string", "pattern": "^[0-9]{4}Q[1-4]$"},
    "association": {"enum": ["VERIFIED_ASSOCIATION", "CONTRIBUTING_ASSOCIATION", "WEAK_RELATION", "UNSUPPORTED"]},
    "direction": {"enum": ["UP", "DOWN", "MIXED", "UNCERTAIN"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "transmissionChain": {
      "type": "array",
      "prefixItems": [
        {"const": "重大事件"}, {"const": "行业/宏观变量"}, {"const": "公司业务暴露"},
        {"const": "经营指标"}, {"const": "财务结果"}, {"const": "竞争解释"}
      ],
      "minItems": 6,
      "maxItems": 6
    }
  }
}
