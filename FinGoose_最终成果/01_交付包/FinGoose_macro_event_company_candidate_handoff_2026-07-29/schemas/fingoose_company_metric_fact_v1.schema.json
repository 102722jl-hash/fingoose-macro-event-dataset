{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fingoose.local/schemas/fingoose_company_metric_fact_v1.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["metric_fact_id", "dataset_version", "dossier_id", "company_code", "metric", "period", "unit", "currency", "value_decimal", "source_tier", "evidence_refs"],
  "properties": {
    "metric_fact_id": {"type": "string", "minLength": 1},
    "dataset_version": {"const": "fingoose-macro-event-company-v1.0"},
    "dossier_id": {"type": "string", "minLength": 1},
    "company_code": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ)$"},
    "metric": {"type": "string", "minLength": 1},
    "period": {"type": "string", "pattern": "^[0-9]{4}Q[1-4]$"},
    "observation_quarter": {"type": "string", "pattern": "^[0-9]{4}Q[1-4]$"},
    "unit": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "value": {"type": "number"},
    "value_decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "source_tier": {"enum": ["TIER_1", "TIER_2", "TIER_3"]},
    "evidence_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": true,
        "required": ["source_id", "source_locator"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_locator": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
