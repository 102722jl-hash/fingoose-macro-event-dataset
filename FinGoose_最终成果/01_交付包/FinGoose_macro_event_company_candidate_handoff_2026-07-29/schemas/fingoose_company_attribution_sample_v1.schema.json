{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fingoose.local/schemas/fingoose_company_attribution_sample_v1.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["record_id", "dataset_version", "dossier_id", "event_id", "company_code", "observation_quarter", "association", "direction", "confidence", "transmission_chain", "counterevidence", "review_id"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^company-attribution-event-[0-9]{2}-[0-9]{6}-(sh|sz)$"},
    "dataset_version": {"const": "fingoose-macro-event-company-v1.0"},
    "dossier_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "pattern": "^event-[0-9]{2}$"},
    "company_code": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ)$"},
    "observation_quarter": {"type": "string", "pattern": "^[0-9]{4}Q[1-4]$"},
    "association": {"enum": ["VERIFIED_ASSOCIATION", "CONTRIBUTING_ASSOCIATION", "WEAK_RELATION", "UNSUPPORTED"]},
    "direction": {"enum": ["UP", "DOWN", "MIXED", "UNCERTAIN"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "transmission_chain": {
      "const": ["重大事件", "行业/宏观变量", "公司业务暴露", "经营指标", "财务结果", "竞争解释"]
    },
    "counterevidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review_id": {"type": "string", "minLength": 1}
  }
}
