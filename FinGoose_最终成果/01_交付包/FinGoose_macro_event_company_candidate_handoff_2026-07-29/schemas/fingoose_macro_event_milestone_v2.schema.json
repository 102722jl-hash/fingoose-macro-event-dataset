{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fingoose.local/schemas/fingoose_macro_event_milestone_v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["milestone_id", "dataset_version", "release_tier", "event_id", "occurred_at", "first_public_at", "phase", "fact", "sources", "visibility", "anchor_role", "impact_tags", "expectation"],
  "properties": {
    "milestone_id": {"type": "string", "pattern": "^milestone-event-[0-9]{2}-[a-f0-9]{12}$"},
    "dataset_version": {"const": "fingoose-macro-event-attribution-v2.0"},
    "release_tier": {"const": "CANDIDATE"},
    "event_id": {"type": "string", "pattern": "^event-[0-9]{2}$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "first_public_at": {"type": "string", "format": "date-time"},
    "phase": {"enum": ["PRECONDITION", "INITIAL_SHOCK", "ESCALATION", "POLICY_RESPONSE", "EASING", "SECONDARY_SHOCK"]},
    "fact": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "visibility": {"enum": ["PUBLIC_PREDICTION", "HIDDEN_VALIDATION"]},
    "anchor_role": {"enum": ["PRIMARY", "SECONDARY", "NONE"]},
    "impact_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expectation": {"$ref": "#/$defs/expectation"}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "source_tier", "published_at", "sha256"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source_tier": {"enum": ["A", "B", "C", "D"]},
        "published_at": {"type": "string", "format": "date-time"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "knownNumber": {"oneOf": [{"type": "number"}, {"const": "UNKNOWN"}]},
    "expectation": {
      "type": "object",
      "required": ["type", "consensus", "actual", "surprise"],
      "properties": {
        "type": {"enum": ["SCHEDULED_RELEASE", "UNSCHEDULED_SHOCK", "EVOLVING_EVENT"]},
        "consensus": {"$ref": "#/$defs/knownNumber"},
        "actual": {"$ref": "#/$defs/knownNumber"},
        "surprise": {"$ref": "#/$defs/knownNumber"},
        "qualitative_baseline": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "UNSCHEDULED_SHOCK"}}, "required": ["type"]},
          "then": {
            "properties": {"consensus": {"const": "UNKNOWN"}, "actual": {"const": "UNKNOWN"}, "surprise": {"const": "UNKNOWN"}}
          }
        },
        {
          "if": {"properties": {"type": {"const": "EVOLVING_EVENT"}}, "required": ["type"]},
          "then": {
            "required": ["qualitative_baseline"],
            "properties": {"consensus": {"const": "UNKNOWN"}, "actual": {"const": "UNKNOWN"}, "surprise": {"const": "UNKNOWN"}}
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
